{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist", // Output to dist folder
    "rootDir": "./src", // Look for source files in the src folder
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true // Skip type checking for declaration files (optional)
  },
  "exclude": [
    "node_modules",
    "prisma.config.ts" // Is file ko compile hone se rok dein
  ]
}
